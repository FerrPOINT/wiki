@@ -197,4 +204,53 @@ describe('DocumentComposePage', () => {
     expect(alert).toHaveTextContent('Проверьте заполнение полей: Название: required')
     expect(alert).not.toHaveTextContent('requestId')
   })
+
+  it('reports a failed space catalogue and retries without discarding the draft or usable templates', () => {
+    setupCompose({}, '/documents/new?space=eng', {
+      spaces: { isError: true, error: { code: 'UNAVAILABLE', message: 'requestId=private' } },
+    })
+    fireEvent.change(screen.getByLabelText('Название'), {
+      target: { value: 'Несохранённый черновик' },
+    })
+    fireEvent.change(screen.getByLabelText('Markdown документа'), {
+      target: { value: '# Рабочий текст' },
+    })
+
+    const alert = screen.getByRole('alert')
+    expect(alert).toHaveTextContent('Не удалось загрузить пространства')
+    expect(alert).not.toHaveTextContent('private')
+    fireEvent.click(within(alert).getByRole('button'))
+    expect(spacesRefetch).toHaveBeenCalledOnce()
+    expect(templatesRefetch).not.toHaveBeenCalled()
+    expect(screen.getByLabelText('Название')).toHaveValue('Несохранённый черновик')
+    expect(screen.getByLabelText('Markdown документа')).toHaveValue('# Рабочий текст')
+    expect(screen.getByRole('button', { name: 'План проверки' })).toBeVisible()
+    expect(createDocumentMutate).not.toHaveBeenCalled()
+  })
+
+  it('localizes a template failure while retaining the selected space and draft', () => {
+    setupCompose({}, '/documents/new?space=eng', {
+      templates: { isError: true, error: { code: 'UNAVAILABLE', message: 'requestId=private' } },
+    })
+    fireEvent.change(screen.getByLabelText('Название'), {
+      target: { value: 'Черновик без шаблона' },
+    })
+
+    const alert = screen.getByRole('alert')
+    expect(alert).toHaveTextContent('Не удалось загрузить шаблоны')
+    fireEvent.click(within(alert).getByRole('button'))
+    expect(templatesRefetch).toHaveBeenCalledOnce()
+    expect(spacesRefetch).not.toHaveBeenCalled()
+    expect(screen.getByLabelText('Пространство')).toHaveValue('ENG')
+    expect(screen.getByLabelText('Название')).toHaveValue('Черновик без шаблона')
+    expect(screen.getByRole('button', { name: 'Сохранить черновик' })).toBeEnabled()
+    expect(createDocumentMutate).not.toHaveBeenCalled()
+  })
+
+  it('shows the space catalogue loading state without submitting a document', () => {
+    setupCompose({}, '/documents/new?space=eng', { spaces: { isLoading: true } })
+    expect(screen.getByText('Загружаем пространства')).toBeVisible()
+    expect(screen.getByLabelText('Пространство')).toHaveValue('ENG')
+    expect(createDocumentMutate).not.toHaveBeenCalled()
+  })
 })
