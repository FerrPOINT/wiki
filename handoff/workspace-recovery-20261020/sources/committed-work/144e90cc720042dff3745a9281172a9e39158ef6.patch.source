@@ -0,0 +1,19 @@
+<!-- BEGIN BASE FRONTEND RULES -->
+## Общий UI-контракт Base
+
+- Использовать общий shell, branding и tokens Base. Контент и доменные решения
+  принадлежат продукту; страницы входа Auth не требуют доступности Admin.
+- Описать маршруты, роли, состояния и layout modes в route contract. Приватный
+  operational route сохраняет SSO; fixtures используют synthetic данные.
+- Перед коммитом выполнить route/acceptance gates и матрицу viewport, тем,
+  direct/reload, keyboard/focus, geometry, console/network.
+- Browser evidence относится к committed source SHA и реальному candidate image.
+  После evidence допускаются документационные коммиты, если runtime fingerprints
+  не изменились. Secrets и реальные пользовательские данные исключить.
+- Изменение публичных контрактов сверять с backend/OpenAPI; SDK сохраняет HTTP
+  status, бизнес-код и correlation id, включая пустые error responses.
+- Compose-кандидаты работают только в собственном временном project; cleanup
+  выполняется при успехе, ошибке и отмене. Runtime workspace не пересоздавать.
+
+Этот блок обновляется `services-base/scripts/sync_frontend_agents.mjs`.
+<!-- END BASE FRONTEND RULES -->
diff --git a/frontend/Dockerfile.umbrella b/frontend/Dockerfile.umbrella
index 737c4ea..1b39fdb 100644
--- a/frontend/Dockerfile.umbrella
+++ b/frontend/Dockerfile.umbrella
@@ -1,8 +1,9 @@
+ARG SDLC_RUNTIME_FLAVOR=sdlc1
 # Umbrella build for the SDLC fleet root compose (context = /opt/dev/sdlc).
 # The repo's own frontend/Dockerfile builds with context=repo-root only; this
 # variant additionally stages the sibling services-base frontend so the
 # `@sdlc/ui` file dependency (../../services-base/frontend) resolves.
-FROM node:22.20.0-bookworm-slim AS builder
+FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS builder
 
 RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
 
@@ -25,7 +26,9 @@ ARG VITE_AUTH_ISSUER="http://localhost:7701"
 ENV VITE_AUTH_ISSUER=${VITE_AUTH_ISSUER}
 RUN pnpm generate:api && pnpm build
 
-FROM nginx:alpine
+FROM nginx:1.29.8-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS sdlc1
+FROM nginx:1.31.6-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2 AS sdlc2
+FROM ${SDLC_RUNTIME_FLAVOR} AS runtime
 COPY --from=builder /workspace/wiki/frontend/dist /usr/share/nginx/html
 COPY wiki/frontend/nginx.conf /etc/nginx/conf.d/default.conf
 EXPOSE 80
diff --git a/frontend/nginx.conf b/frontend/nginx.conf
index 26b1a99..217f4c1 100644
--- a/frontend/nginx.conf
+++ b/frontend/nginx.conf
@@ -22,7 +22,7 @@ server {
     }
 
     location /api/ {
-        proxy_pass http://backend:3456;
+        proxy_pass http://wiki-backend:3456;
         proxy_http_version 1.1;
         proxy_set_header Host $host;
         proxy_set_header X-Real-IP $remote_addr;
