 test.describe('wiki smoke', () => {
+  for (const theme of ['dark', 'gray', 'light'] as const) {
+    test(`Base notification bootstrap: empty host in ${theme}`, async ({ page }, testInfo) => {
+      await installWikiApiMocks(page)
+      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+      const errors: string[] = []
+      page.on('pageerror', (error) => errors.push(error.message))
+      page.on('console', (message) => {
+        if (message.type() === 'error') errors.push(message.text())
+      })
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: 1080 })
+        await gotoWiki(page, '/search?space=BASE&q=Wiki&keep=1#results')
+        await expect(page.getByRole('heading', { level: 1, name: 'Поиск' })).toBeVisible()
+        const region = page.getByRole('region', { name: 'Уведомления', exact: true })
+        await expect(region).toHaveCount(1)
+        await expect(region.locator('[data-sonner-toast]')).toHaveCount(0)
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        await page.reload()
+        await expect(page).toHaveURL(`${baseURL}/search?space=BASE&q=Wiki&keep=1#results`)
+        await expect(page.getByRole('heading', { level: 1, name: 'Поиск' })).toBeVisible()
+        await expect(region).toHaveCount(1)
+        await expect(region.locator('[data-sonner-toast]')).toHaveCount(0)
+        if (width === 375 || width === 1920 || width === 2560) {
+          expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+          await page.screenshot({
+            path: testInfo.outputPath(`notification-bootstrap-${theme}-${width}.png`),
+            fullPage: true,
+          })
+        }
+      }
+      expect(errors).toEqual([])
+      await testInfo.attach('notification-bootstrap-scope.json', {
+        body: JSON.stringify({
+          theme,
+          emptyHost: true,
+          fixtureOnly: true,
+          productToastCallers: false,
+          actualImages: false,
+          releaseAcceptance: false,
+        }),
+        contentType: 'application/json',
+      })
+    })
+  }
