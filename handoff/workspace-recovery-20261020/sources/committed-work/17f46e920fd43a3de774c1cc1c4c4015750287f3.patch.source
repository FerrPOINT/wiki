diff --git a/docs/plans/2026-10-02-base-ui-reconciliation-and-templates.md b/docs/plans/2026-10-02-base-ui-reconciliation-and-templates.md
new file mode 100644
index 0000000..2449d1c
--- /dev/null
+++ b/docs/plans/2026-10-02-base-ui-reconciliation-and-templates.md
@@ -0,0 +1,63 @@
+# Base Reconciliation И Templates
+
+## Scope
+
+Продолжение полного UI/UX-плана, не его сокращение до одной страницы. Owned
+checkout: `feat/base-ui-standard`; original dirty checkout не меняется.
+Сохранённые local defaults используются без GitHub/fetch/Actions.
+
+## Source Reconciliation
+
+Merge `910087cb0d1ea410050a06ab6e10465bbdf6b179` объединяет task source
+`66ed175b90615c39bef97f85492d733cad0cb905` и saved default
+`efadcdb71420e46c34b12043783b7e393241972e`. Сохранены incoming SSO recovery,
+Base telemetry/config/OpenAPI/time helpers и locked build tooling. Pin:
+`6f63595a891f78b96b665889f80e6eb5cf34381a`, общий с Admin и CI/CD.
+Конфликты разрешены сохранением strict UI gate и generated-exports typecheck;
+дублированный packageManager удалён. Default refs/runtime не изменены.
+
+## Templates
+
+- Base ListPage владеет header, filter row и spacing; Select/FormField/PendingForm
+  и ResourceStateView заменяют local controls/form/states. Product API не меняется.
+- Independent identity/catalog queries блокируют writes при error/loading/refetch.
+  Temporary cached catalog остаётся readonly; terminal/non-repeatable failure
+  скрывает rows. Не выдавать ошибка загрузки за empty или предлагать retry для 403.
+- Draft не теряется при collapse/query/hash/permission loss; Base guard защищает
+  pathname/reload. Поля и submit handler учитывают pending/freshness, same-tick
+  duplicate submit не создаёт вторую mutation. Space/template context сохранён.
+
+## Verification Boundaries
+
+Frozen offline install, 240 reconciliation frontend tests и OpenAPI check/compat
+прошли до page migration. После migration: 246 units (18 template cases), lint,
+typecheck/build, strict installed Base/19-pattern gate и effective theme contrast.
+Rust fmt/all-target/all-feature strict clippy/workspace tests прошли. Workspace
+reports включают 16 env-gated PG cases с ранним return без URL; они не считаются
+PG evidence. Все 16 отдельно выполнены на fresh temporary PostgreSQL успешно.
+Temporary PG/network удалены, own cache volumes сохранены.
+
+Focused Chromium: 1 passed, 30 theme/width observations, 40 PNG, keyboard/focus,
+cached 0/503/403/404/422, draft guard и axe. Полный Chromium smoke: 21 passed,
+zero skipped/flaky/retries, 322 PNG, включая 210 shared-mode geometry captures.
+HTTP/OIDC synthetic: не actual image acceptance. Release workspace собран,
+OpenAPI release binary совпадает с committed JSON. Offline Swagger input взят
+из debug cache: v5.17.14.zip, SHA256
+`481244d0812097b11fbaeef79f71d942b171617f9c9f9514e63acbe13e71ccdc`.
+Initial offline build без этого input диагностический, не зелёный evidence.
+
+Full format gate прошёл после штатной LF-нормализации 51 файлов: каждый файл
+сверен `git diff --exit-code`, индекс обновлён без content changes. Product FP
+до/после одинаковый:
+`524518ae8702fe1c882a041af7e2dc44c657475526f7c3d6b450c419da53fa39`.
+Frozen install использовал 451 reused / zero downloaded; lock/schema drift нет.
+Source attestation/capture metadata фиксируются отдельно после source commit.
+README gallery и actual image QA этим документом не закрываются.
+
+## Remaining Full Scope
+
+Document/compose/evidence/settings/admin/phase compositions и cold audit titles
+без N+1/API extension требуют отдельной проверки. Затем Task/Fleet/Workflow/Pulse,
+all operational routes/roles/states на согласованных images, launcher/health/SSO,
+current desktop README gallery/provenance, local default integration и mirror.
+Все 14 исходных findings открыты; Pulse вне mirror. Public API/DB/auth не менялись.
diff --git a/frontend/e2e/smoke.spec.ts b/frontend/e2e/smoke.spec.ts
index ea21d2e..00681da 100644
--- a/frontend/e2e/smoke.spec.ts
+++ b/frontend/e2e/smoke.spec.ts
@@ -1165,6 +1165,155 @@ test.describe('wiki smoke', () => {
     }
   })
 
+  test('uses Base template controls, states and draft protection across themes and widths', async ({
+    page,
+  }, testInfo) => {
+    test.setTimeout(300_000)
+    const api = await installWikiApiMocks(page)
+    page.setDefaultTimeout(15_000)
+    const geometry: Array<{
+      theme: string
+      width: number
+      controls: Array<{ label: string | null; height: number }>
+    }> = []
+    let status = 200
+    const errors: string[] = []
+    page.on('pageerror', (error) => errors.push(error.message))
+    await page.route('**/api/v1/templates', async (route) => {
+      if (route.request().method() !== 'GET' || status === 200) return route.fallback()
+      if (status === 0) return route.abort('failed')
+      return routeJson(
+        route,
+        {
+          code: status === 403 ? 'FORBIDDEN' : 'SERVICE_UNAVAILABLE',
+          message: 'Catalog unavailable',
+        },
+        status,
+      )
+    })
+    await gotoWiki(page, '/templates?space=BASE&keep=1#catalog')
+    for (const theme of ['light', 'gray', 'dark']) {
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      await page.reload()
+      await page.getByRole('button', { name: 'Новый шаблон', exact: true }).click()
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+        await expect(page.locator('.base-page-title')).toHaveText('Шаблоны')
+        await page
+          .getByRole('textbox', { name: 'Название шаблона', exact: true })
+          .fill('Безопасный черновик')
+        await page
+          .getByRole('textbox', { name: 'Markdown шаблона', exact: true })
+          .fill('# Черновик\n\n' + 'Длинный текст '.repeat(30))
+        const controls = await page
+          .locator('main button, main input, main select, main a')
+          .evaluateAll((elements) =>
+            elements
+              .filter((element) => element.getClientRects().length > 0)
+              .map((element) => ({
+                label: element.getAttribute('aria-label') ?? element.textContent,
+                height: element.getBoundingClientRect().height,
+              })),
+          )
+        expect(controls.length).toBeGreaterThan(5)
+        for (const control of controls)
+          expect(control.height, String(control.label)).toBeGreaterThanOrEqual(
+            width < 768 ? 44 : 40,
+          )
+        geometry.push({ theme, width, controls })
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        if (width === 375 || width === 1920)
+          expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`templates-${theme}-${width}.png`),
+          fullPage: true,
+        })
+      }
+      await page.getByRole('textbox', { name: 'Название шаблона', exact: true }).fill('')
+      await page.getByRole('textbox', { name: 'Markdown шаблона', exact: true }).fill('')
+      await expect
+        .poll(() =>
+          page.evaluate(() => {
+            const event = new Event('beforeunload', { cancelable: true })
+            window.dispatchEvent(event)
+            return event.defaultPrevented
+          }),
+        )
+        .toBe(false)
+    }
+    await page
+      .getByRole('textbox', { name: 'Название шаблона', exact: true })
+      .fill('Безопасный черновик')
+    await page.getByRole('textbox', { name: 'Markdown шаблона', exact: true }).fill('# Черновик')
+    await page.getByRole('button', { name: 'Свернуть', exact: true }).click()
+    await page.getByRole('searchbox', { name: 'Найти шаблон' }).fill('Требования')
+    await expect(page).toHaveURL(/keep=1.*q=.*#catalog$/)
+    await page.getByRole('button', { name: 'Новый шаблон', exact: true }).click()
+    await expect(page.getByRole('textbox', { name: 'Название шаблона', exact: true })).toHaveValue(
+      'Безопасный черновик',
+    )
+    await page.getByRole('link', { name: 'Создать документ', exact: true }).click()
+    const guard = page.getByRole('alertdialog')
+    await expect(guard).toBeVisible()
+    await guard.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await expect(guard).toBeHidden()
+    await expect(page.getByRole('link', { name: 'Создать документ', exact: true })).toBeFocused()
+    expect(api.templateCreateRequests).toEqual([])
+    await page.getByRole('textbox', { name: 'Название шаблона', exact: true }).fill('')
+    await page.getByRole('textbox', { name: 'Markdown шаблона', exact: true }).fill('')
+    for (const failure of [0, 503, 403, 404, 422]) {
+      status = 200
+      await gotoWiki(page, '/templates?space=BASE')
+      await expect(page.getByRole('link', { name: /^Использовать шаблон/ })).toBeVisible()
+      status = failure
+      await page.getByRole('link', { name: 'Пространства', exact: true }).click()
+      await page.getByRole('link', { name: 'Шаблоны', exact: true }).click()
+      const repeatable = failure === 0 || failure === 503
+      const state = repeatable
+        ? 'partial-error'
+        : failure === 403
+          ? 'permission-denied'
+          : failure === 404
+            ? 'not-found'
+            : 'error'
+      await expect(
+        state === 'error' ? page.getByRole('alert') : page.locator(`[data-page-state="${state}"]`),
+      ).toBeVisible({ timeout: 15_000 })
+      await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(
+        repeatable ? 1 : 0,
+      )
+      await expect(page.getByRole('link', { name: /^Использовать шаблон/ })).toHaveCount(
+        repeatable ? 1 : 0,
+      )
+      if (repeatable)
+        await expect(page.getByRole('button', { name: 'Новый шаблон', exact: true })).toBeDisabled()
+      for (const width of [375, 1920]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`templates-cached-${failure}-${width}.png`),
+          fullPage: true,
+        })
+      }
+    }
+    expect(errors).toEqual([])
+    await testInfo.attach('templates-geometry', {
+      body: JSON.stringify(geometry),
+      contentType: 'application/json',
+    })
+  })
+
   test('previews a new document and protects its unsaved draft during navigation', async ({
     page,
   }) => {
