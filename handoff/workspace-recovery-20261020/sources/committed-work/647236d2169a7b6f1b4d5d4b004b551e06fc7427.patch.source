+        await expect(page.locator('[data-page-layout]')).toBeVisible()
+        await expect(
+          events.getByText(title, { exact: true }).filter({ visible: true }).first(),
+        ).toBeVisible()
+        expect(reads - before).toBe(2)
+      }
+    }
+    rejected = true
+    await page.getByRole('link', { name: 'Поиск', exact: true }).first().click()
+    await expect(page.locator('[data-page-layout]')).toBeVisible()
+    await page.getByRole('link', { name: 'Аудит', exact: true }).first().click()
+    await expect(
+      page.getByText(
+        'Названия некоторых документов недоступны; события и технические данные сохранены',
+      ),
+    ).toBeVisible()
+    await expect(page.getByText(title, { exact: true })).toHaveCount(0)
+    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+    await expect(page.getByText('Опубликован документ', { exact: true }).last()).toBeVisible()
+    expect(errors).toEqual([])
+  })
