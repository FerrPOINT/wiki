 describe('wiki API hooks', () => {
+  it('loads a cold audit document page with deduplicated shared document keys', async () => {
+    const id = '00000000-0000-4000-8000-000000000099'
+    getDocument.mockResolvedValue(documentResponse({ id }))
+    const { result } = renderHook(() => useAuditDocuments([id, id]), { wrapper })
+    await waitFor(() => expect(result.current[0]?.query.isSuccess).toBe(true))
+    expect(result.current).toHaveLength(1)
+    expect(result.current[0]?.query.isFetchedAfterMount).toBe(true)
+    expect(getDocument).toHaveBeenCalledExactlyOnceWith(id)
+  })
+
+  it('bounds audit document reads to 20 distinct objects and disables them for terminal audit states', async () => {
+    getDocument.mockImplementation(async (id: string) => documentResponse({ id }))
+    const ids = Array.from({ length: 30 }, (_, index) => `document-${index}`)
+    const { result, rerender } = renderHook(({ enabled }) => useAuditDocuments(ids, enabled), {
+      wrapper,
+      initialProps: { enabled: false },
+    })
+    expect(result.current).toHaveLength(0)
+    expect(getDocument).not.toHaveBeenCalled()
+    rerender({ enabled: true })
+    await waitFor(() => expect(result.current.every(({ query }) => query.isSuccess)).toBe(true))
+    expect(result.current).toHaveLength(20)
+    expect(getDocument).toHaveBeenCalledTimes(20)
+  })
+
