@@ -268,6 +268,19 @@ export function useDocument(documentId: string) {
   })
 }
 
+export function useAuditDocuments(documentIds: string[], enabled = true) {
+  const ids = enabled ? [...new Set(documentIds)].slice(0, 20) : []
+  const queries = useQueries({
+    queries: ids.map((id) => ({
+      queryKey: wikiKeys.document(id),
+      queryFn: () => getDocument(id),
+      staleTime: 0,
+      retry: false,
+    })),
+  })
+  return ids.map((id, index) => ({ id, query: queries[index]! }))
+}
+
 export function useDocumentRevisions(
   documentId: string,
   params: DocumentRevisionListParams = defaultDocumentRevisionListParams,
