   await expect(page).toHaveURL(new URL(expectedPath, `${baseURL}/`).toString(), { timeout: 10_000 })
 }
 
@@ -1351,6 +1353,7 @@ test.describe('wiki smoke', () => {
     for (const theme of ['light', 'gray', 'dark']) {
       await page.evaluate((value) => localStorage.setItem('theme', value), theme)
