+      isError: true,
+      error: { status: 503 },
+      refetch: retry,
+    })
+    rerender()
+    expect(screen.getByRole('textbox', { name: 'Название' })).toHaveValue('Draft')
+    expect(screen.getByRole('textbox', { name: 'Название' })).toBeDisabled()
+    fireEvent.click(screen.getByRole('button', { name: 'Повторить' }))
+    expect(retry).toHaveBeenCalledOnce()
+  })
+
+  it.each(['missing', 'archived'])('does not offer create for a %s parent', (parent) => {
+    const { rerender } = setupCompose()
+    const ready = initialQuery(useSpaces)
+    useSpaces.mockReturnValue({
+      ...ready,
+      data: {
+        spaces:
+          parent === 'missing'
+            ? []
+            : ready.data.spaces.map((space: Record<string, unknown>) => ({
+                ...space,
+                status: 'archived',
+              })),
+      },
+    })
+    rerender()
+    expect(screen.queryByRole('button', { name: 'Сохранить черновик' })).not.toBeInTheDocument()
+    expect(createDocumentMutate).not.toHaveBeenCalled()
+  })
+
+  it('keeps optional template failures independent and never auto-overwrites typed body', () => {
+    const { rerender } = setupCompose({}, '/documents/new?space=eng&template=tpl-test-plan')
+    const ready = initialQuery(useTemplates)
+    useTemplates.mockReturnValue({ ...ready, data: undefined, isLoading: true })
+    rerender()
+    fireEvent.change(screen.getByRole('textbox', { name: 'Markdown документа' }), {
+      target: { value: '# Own draft' },
+    })
+    useTemplates.mockReturnValue(ready)
+    rerender()
+    expect(screen.getByRole('textbox', { name: 'Markdown документа' })).toHaveValue('# Own draft')
+    useTemplates.mockReturnValue({ ...ready, isError: true, error: { status: 403 } })
+    rerender()
+    expect(screen.queryByRole('button', { name: 'План проверки' })).not.toBeInTheDocument()
+    fireEvent.change(screen.getByRole('textbox', { name: 'Название' }), {
+      target: { value: 'Draft' },
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'Сохранить черновик' }))
+    expect(createDocumentMutate).toHaveBeenCalledOnce()
+  })
+
+  it('validates whitespace in preview and blocks same-tick double submit', async () => {
+    const { router } = setupCompose()
+    const form = screen.getByRole('textbox', { name: 'Название' }).closest('form')!
+    fireEvent.change(screen.getByRole('textbox', { name: 'Название' }), {
+      target: { value: '   ' },
+    })
+    fireEvent.change(screen.getByRole('textbox', { name: 'Markdown документа' }), {
+      target: { value: '   ' },
+    })
+    fireEvent.submit(form)
+    expect(createDocumentMutate).not.toHaveBeenCalled()
+    fireEvent.change(screen.getByRole('textbox', { name: 'Название' }), {
+      target: { value: 'Draft' },
+    })
+    fireEvent.change(screen.getByRole('textbox', { name: 'Markdown документа' }), {
+      target: { value: '# Draft' },
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'Предпросмотр' }))
+    await waitFor(() => expect(router.state.location.search).toContain('tab=preview'))
+    act(() => {
+      fireEvent.submit(form)
+      fireEvent.submit(form)
+    })
+    expect(createDocumentMutate).toHaveBeenCalledOnce()
+  })
+
+  it('encodes dossier links and carries the selected space', () => {
+    setupCompose()
+    fireEvent.change(screen.getByLabelText('Задача'), { target: { value: ' TASK/42 ' } })
+    fireEvent.change(screen.getByLabelText('Фаза'), { target: { value: 'phase#1' } })
+    expect(screen.getByRole('link', { name: 'Задача TASK/42' })).toHaveAttribute(
+      'href',
+      '/tasks/TASK%2F42?space=ENG',
+    )
+    expect(screen.getByRole('link', { name: 'Фаза phase#1' })).toHaveAttribute(
+      'href',
+      '/phases/phase%231?space=ENG',
+    )
+  })
 })
