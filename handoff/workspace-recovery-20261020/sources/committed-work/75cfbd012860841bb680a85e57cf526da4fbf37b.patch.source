@@ -1314,6 +1314,155 @@ test.describe('wiki smoke', () => {
     })
   })
 
+  test('uses Base compose fields, URL tabs and detail geometry across themes and widths', async ({
+    page,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    await installWikiApiMocks(page)
+    const failures: string[] = []
+    page.on('pageerror', (error) => failures.push(error.message))
+    page.on('console', (message) => {
+      if (message.type() === 'error') failures.push(message.text())
+    })
+    for (const theme of ['dark', 'gray', 'light']) {
+      await gotoWiki(page, '/documents/new?space=BASE&source=search#editor')
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      await page.reload()
+      await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+      await page.getByRole('textbox', { name: 'Название', exact: true }).fill(longUnbrokenValue)
+      await page
+        .getByRole('textbox', { name: 'Markdown документа', exact: true })
+        .fill(longUnbrokenValue)
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: 1080 })
+        const main = page.locator('[data-page-layout]')
+        await expect(main).toHaveAttribute('data-page-layout', 'detail-with-aside')
+        await expect
+          .poll(() =>
+            main.evaluate((element) =>
+              Array.from(element.querySelectorAll('input, select, button, [role="tab"]'))
+                .filter(
+                  (control) => control.getClientRects().length && !control.closest('[hidden]'),
+                )
+                .every(
+                  (control) =>
+                    control.getBoundingClientRect().height >= (innerWidth < 768 ? 44 : 40),
+                ),
+            ),
+          )
+          .toBe(true)
+        const measurements = await main.evaluate((element) => {
+          const split = element.querySelector('.page-split')!
+          const aside = split.querySelector('aside')!
+          const content = split.firstElementChild!
+          const controls = Array.from(
+            element.querySelectorAll('input, select, button, [role="tab"]'),
+          ).filter((control) => control.getClientRects().length && !control.closest('[hidden]'))
+          return {
+            fits: document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+            aside: aside.getBoundingClientRect().width,
+            stacked: aside.getBoundingClientRect().top >= content.getBoundingClientRect().bottom,
+            targets: controls.map((control) => ({
+              label: control.getAttribute('aria-label') ?? control.textContent ?? control.id,
+              height: control.getBoundingClientRect().height,
+              minHeight: getComputedStyle(control).minHeight,
+            })),
+          }
+        })
+        expect(measurements.fits).toBe(true)
+        await expect
+          .poll(() =>
+            page
+              .getByRole('textbox', { name: 'Markdown документа', exact: true })
+              .evaluate((element) => element.getBoundingClientRect().height),
+          )
+          .toBeGreaterThanOrEqual(384)
+        for (const target of measurements.targets)
+          expect(
+            target.height,
+            `${theme}/${width}: ${JSON.stringify(target)}`,
+          ).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        if (width >= 1024) expect(Math.abs(measurements.aside - 320)).toBeLessThanOrEqual(1)
+        else expect(measurements.stacked).toBe(true)
+        if ([375, 1920, 2560].includes(width)) {
+          expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+          await page.evaluate(() => {
+            ;(document.activeElement as HTMLElement)?.blur()
+            window.scrollTo(0, 0)
+          })
+          await page.screenshot({
+            path: testInfo.outputPath(`compose-${theme}-${width}.png`),
+            fullPage: true,
+          })
+        }
+      }
+      await page.getByRole('button', { name: 'Предпросмотр' }).click()
+      await expect(page).toHaveURL(
+        `${baseURL}/documents/new?space=BASE&source=search&tab=preview#editor`,
+      )
+      await expect(page.getByRole('alertdialog')).toHaveCount(0)
+      await page.goBack()
+      await expect(
+        page.getByRole('textbox', { name: 'Markdown документа', exact: true }),
+      ).toHaveValue(longUnbrokenValue)
+      await page.getByRole('link', { name: 'Пространства', exact: true }).click()
+      await page.getByRole('alertdialog').getByRole('button', { name: 'Подтвердить' }).click()
+      await expect(page).toHaveURL(/\/spaces/)
+    }
+    expect(failures).toEqual([])
+  })
+
+  test('retains the compose draft across a failed background refresh and explicit retry', async ({
+    page,
+  }) => {
+    await installWikiApiMocks(page)
+    let status = 200
+    let refreshRequests = 0
+    await page.route('**/api/v1/spaces', (route) => {
+      if (status !== 200) refreshRequests++
+      return status === 200
+        ? route.fallback()
+        : routeJson(route, { code: 'SERVICE_UNAVAILABLE', message: 'Unavailable' }, status)
+    })
+    await gotoWiki(page, '/documents/new?space=BASE')
+    const title = page.getByRole('textbox', { name: 'Название', exact: true })
+    await title.fill('Сохранённый в памяти черновик')
+    await page.getByRole('textbox', { name: 'Markdown документа', exact: true }).fill('# Own draft')
+    status = 503
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    await expect.poll(() => refreshRequests, { timeout: 15_000 }).toBeGreaterThan(0)
+    await expect(page.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 15_000 })
+    await expect(title).toHaveValue('Сохранённый в памяти черновик')
+    await expect(title).toBeDisabled()
+    await expect(page.getByRole('button', { name: 'Сохранить черновик' })).toBeDisabled()
+    status = 200
+    await page.getByRole('button', { name: 'Повторить', exact: true }).click()
+    await expect(title).toBeEnabled()
+    await expect(
+      page.getByRole('textbox', { name: 'Markdown документа', exact: true }),
+    ).toHaveValue('# Own draft')
+  })
+
+  for (const status of [403, 404]) {
+    test(`does not offer compose controls for a space source HTTP ${status}`, async ({ page }) => {
+      await installWikiApiMocks(page)
+      await page.route('**/api/v1/spaces', (route) =>
+        routeJson(
+          route,
+          { code: status === 403 ? 'FORBIDDEN' : 'NOT_FOUND', message: 'Unavailable' },
+          status,
+        ),
+      )
+      await gotoWiki(page, '/documents/new?space=BASE')
+      await expect(
+        page.locator(`[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`),
+      ).toBeVisible({ timeout: 15_000 })
+      await expect(page.getByRole('button', { name: 'Сохранить черновик' })).toHaveCount(0)
+      await expect(page.getByRole('textbox', { name: 'Название', exact: true })).toHaveCount(0)
+      await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+    })
+  }
+
   test('previews a new document and protects its unsaved draft during navigation', async ({
