diff --git a/frontend/src/pages/not-found/index.tsx b/frontend/src/pages/not-found/index.tsx
new file mode 100644
index 0000000..9505e80
--- /dev/null
+++ b/frontend/src/pages/not-found/index.tsx
@@ -0,0 +1,25 @@
+import { Link, useLocation } from 'react-router'
+import { ArrowLeft } from 'lucide-react'
+import { Button, DetailPage } from '@sdlc/ui/ui'
+
+export function NotFoundPage() {
+  const { pathname } = useLocation()
+  return (
+    <DetailPage
+      title="Недоступный адрес"
+      context={pathname}
+      state={{
+        kind: 'not-found',
+        back: (
+          <Button asChild variant="outline" className="mt-4">
+            <Link to="/">
+              <ArrowLeft className="h-4 w-4" aria-hidden />К обзору
+            </Link>
+          </Button>
+        ),
+      }}
+    >
+      {null}
+    </DetailPage>
+  )
+}
diff --git a/frontend/src/pages/not-found/not-found.test.tsx b/frontend/src/pages/not-found/not-found.test.tsx
new file mode 100644
index 0000000..eb1987f
--- /dev/null
+++ b/frontend/src/pages/not-found/not-found.test.tsx
@@ -0,0 +1,23 @@
+import { render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { describe, expect, it } from 'vitest'
+import { NotFoundPage } from './'
+
+describe('NotFoundPage', () => {
+  it('keeps one Base page heading, the unavailable address and a safe return action', () => {
+    const { container } = render(
+      <MemoryRouter initialEntries={['/unknown-page?space=TEAM']}>
+        <NotFoundPage />
+      </MemoryRouter>,
+    )
+    expect(screen.getByRole('heading', { level: 1, name: 'Недоступный адрес' })).toHaveClass(
+      'base-page-title',
+    )
+    expect(container.querySelectorAll('h1')).toHaveLength(1)
+    expect(screen.getByText('/unknown-page')).toBeInTheDocument()
+    expect(container.querySelector('[data-page-state="not-found"]')).toBeInTheDocument()
+    expect(screen.getByRole('link', { name: 'К обзору' })).toHaveAttribute('href', '/')
+    expect(screen.getByRole('link', { name: 'К обзору' })).toHaveClass('base-control')
+    expect(screen.queryByRole('button', { name: /повторить|создать/i })).not.toBeInTheDocument()
+  })
+})
