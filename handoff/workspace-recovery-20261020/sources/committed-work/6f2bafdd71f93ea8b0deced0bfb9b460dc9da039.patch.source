-  'min-h-10 rounded-md border border-border bg-surface px-3 text-sm text-text-primary focus-visible:outline-2 focus-visible:outline-accent'
+const spaceQuery = textQuery()
+
+function queryState(
+  query: {
+    isLoading: boolean
+    isError: boolean
+    error: unknown
+    data: unknown
+    refetch: () => unknown
+  },
+  loading: string,
+  fallback: string,
+): ResourceState {
+  return query.isError
+    ? resourceErrorState(
+        query.error,
+        () => {
+          void query.refetch()
+        },
+        {
+          hasData: query.data !== undefined,
+          message: formatApiErrorForUser(query.error, fallback),
+        },
+      )
+    : query.isLoading
+      ? { kind: 'loading', message: loading }
+      : { kind: 'ready' }
+}
+
+function hasContent(state: ResourceState): boolean {
+  return state.kind === 'ready' || state.kind === 'partial-error'
+}
+
+function documentHref(path: string, spaceKey: string): string {
+  const url = new URL(path, 'http://wiki.local')
+  url.searchParams.set('space', spaceKey)
+  return `${url.pathname}${url.search}${url.hash}`
+}
 
