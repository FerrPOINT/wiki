 test.describe('wiki smoke', () => {
+  test('restores overview space context after direct login, reload and browser history', async ({
+    page,
+  }) => {
+    await installWikiApiMocks(page)
+    await page.route('**/api/v1/spaces', (route) =>
+      routeJson(route, {
+        spaces: [
+          baseSpace,
+          { ...baseSpace, id: 'space-team', key: 'TEAM', name: 'Команда', document_count: 42 },
+        ],
+      }),
+    )
+    await page.route('**/api/v1/spaces/TEAM/task-summaries?*', (route) =>
+      routeJson(route, {
+        tasks: [{ ...task, task_key: 'TEAM-1', title: 'Задача команды' }],
+        next_cursor: null,
+        total: 999,
+      }),
+    )
+    await page.route('**/api/v1/spaces/TEAM/phase-summaries?*', (route) =>
+      routeJson(route, { phases: [], next_cursor: null, total: 555 }),
+    )
+    const scopedReads: URL[] = []
+    const pageErrors: string[] = []
+    const failedResponses: string[] = []
+    page.on('pageerror', (error) => pageErrors.push(error.message))
+    page.on('response', (response) => {
+      if (response.status() >= 400) failedResponses.push(response.url())
+    })
+    page.on('request', (request) => {
+      const url = new URL(request.url())
+      if (url.pathname.endsWith('-summaries')) scopedReads.push(url)
+    })
+    await gotoWiki(page, '/?space=TEAM&keep=yes&page=3')
+    const select = page.getByRole('combobox', { name: 'Пространство', exact: true })
+    await expect(select).toHaveValue('TEAM')
+    await expect(page.getByRole('link', { name: 'Новый документ', exact: true })).toHaveCount(1)
+    await expect(page.getByRole('link', { name: 'Новый документ', exact: true })).toHaveAttribute(
+      'href',
+      '/documents/new?space=TEAM',
+    )
+    await expect(page.getByRole('link', { name: 'Найти', exact: true })).toHaveAttribute(
+      'href',
+      '/search?space=TEAM',
+    )
+    const stats = page.getByRole('region', { name: 'Показатели Wiki' })
+    await expect(stats.getByText('43', { exact: true })).toBeVisible()
+    await expect(stats.getByText('999', { exact: true })).toBeVisible()
+    await expect(stats.getByText('555', { exact: true })).toBeVisible()
+    await page.reload()
+    await expect(select).toHaveValue('TEAM')
+    await select.selectOption('BASE')
+    await expect(page).toHaveURL(`${baseURL}/?space=BASE&keep=yes`)
+    await page.goBack()
+    await expect(select).toHaveValue('TEAM')
+    await expect(page).toHaveURL(`${baseURL}/?space=TEAM&keep=yes&page=3`)
+    await page.goForward()
+    await expect(select).toHaveValue('BASE')
+    await expect(
+      page
+        .getByRole('region', { name: 'Задачи в Wiki' })
+        .getByRole('link', { name: /Требования к Wiki MVP/ }),
+    ).toHaveAttribute('href', '/tasks/BASE-42?space=BASE')
+    expect(
+      scopedReads
+        .filter((url) => url.pathname.endsWith('/task-summaries'))
+        .every((url) => url.searchParams.get('limit') === '4'),
+    ).toBe(true)
+    expect(
+      scopedReads
+        .filter((url) => url.pathname.endsWith('/phase-summaries'))
+        .every((url) => url.searchParams.get('limit') === '1'),
+    ).toBe(true)
+    expect(pageErrors).toEqual([])
+    expect(failedResponses).toEqual([])
+  })
+
+  test('does not read or offer CRUD for an unknown overview space and wraps long keys', async ({
+    page,
+  }, testInfo) => {
+    await installWikiApiMocks(page)
+    const reads: string[] = []
+    page.on('request', (request) => {
+      const url = new URL(request.url())
+      if (url.pathname === '/api/v1/search' || url.pathname.endsWith('-summaries'))
+        reads.push(url.pathname)
+    })
+    await gotoWiki(page, `/?space=${longUnbrokenValue}`)
+    await expect(page.getByRole('heading', { name: 'Объект не найден' })).toBeVisible()
+    await expect(page.getByRole('link', { name: 'Все пространства', exact: true })).toBeVisible()
+    await expect(page.getByRole('link', { name: 'Новый документ', exact: true })).toHaveCount(0)
+    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+    await expect(page.getByRole('combobox')).toHaveCount(0)
+    for (const width of [375, 1920, 2560]) {
+      await page.setViewportSize({ width, height: 1080 })
+      expect(
+        await page.evaluate(
+          () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+        ),
+      ).toBe(true)
+      await page.screenshot({
+        path: testInfo.outputPath(`overview-missing-${width}.png`),
+        fullPage: true,
+      })
+    }
+    expect(reads).toEqual([])
+  })
+
+  for (const status of [403, 404, 503]) {
+    test(`keeps healthy overview tasks visible after document HTTP ${status} and retries only recoverable failures`, async ({
+      page,
+    }) => {
+      await installWikiApiMocks(page)
+      let recovered = false
+      await page.route('**/api/v1/search?*', (route) => {
+        if (recovered) return routeJson(route, { results: [] })
+        return routeJson(
+          route,
+          {
+            code:
+              status === 403 ? 'FORBIDDEN' : status === 404 ? 'NOT_FOUND' : 'SERVICE_UNAVAILABLE',
+            message: 'Поиск временно недоступен',
+          },
+          status,
+        )
+      })
+      await gotoWiki(page)
+      const documents = page.getByRole('region', { name: 'Последние документы' })
+      const tasks = page.getByRole('region', { name: 'Задачи в Wiki' })
+      await expect(tasks.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+      if (status === 503) {
+        await expect(documents.getByRole('alert')).toContainText('Поиск временно недоступен', {
+          timeout: 15_000,
+        })
+        recovered = true
+        await documents.getByRole('button', { name: 'Повторить', exact: true }).click()
+        await expect(documents.getByText('Недавние документы не найдены')).toBeVisible()
+      } else {
+        await expect(
+          documents.getByRole('heading', {
+            name: status === 403 ? 'Нет доступа' : 'Объект не найден',
+          }),
+        ).toBeVisible({ timeout: 15_000 })
+        await expect(documents.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(
+          0,
+        )
+        await expect(page.getByRole('link', { name: 'Найти', exact: true })).toHaveCount(0)
+        await expect(page.getByRole('link', { name: 'Новый документ', exact: true })).toHaveCount(0)
+      }
+    })
+  }
+
+  test('retains cached overview documents on a recoverable refresh failure but hides them on denied refresh', async ({
+    page,
+  }, testInfo) => {
+    await installWikiApiMocks(page)
