+  resourceErrorState,
+  type ResourceState,
+} from '@sdlc/ui/ui'
+import { textQuery, updateQuery } from '@sdlc/ui/lib'
 import { formatApiErrorForUser } from '@/shared/lib/api-error'
 import { formatDateTime } from '@/shared/lib/wiki-format'
