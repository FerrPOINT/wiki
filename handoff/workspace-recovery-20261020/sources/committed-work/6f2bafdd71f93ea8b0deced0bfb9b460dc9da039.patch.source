+    listSpaces.mockResolvedValue({
+      spaces: [{ ...overviewSpaces[0], status: 'archived', document_count: 0 }],
+    })
+    render(wrapper(<DashboardPage />))
+    await screen.findByText('В этом пространстве пока нет документов')
+    expect(screen.queryByRole('link', { name: 'Новый документ' })).not.toBeInTheDocument()
+    expect(screen.queryByRole('link', { name: 'Создать документ' })).not.toBeInTheDocument()
+  })
+
+  it('shows a denied document section without hiding healthy tasks or offering retry', async () => {
+    setupOverview()
+    searchWiki.mockRejectedValue({ status: 403, code: 'FORBIDDEN' })
+    listTaskSummaries.mockResolvedValue({
+      tasks: [{ task_key: 'BASE-42', title: 'Healthy task', document_count: 1 }],
+      total: 1,
+    })
+    render(wrapper(<DashboardPage />))
+    const documents = within(await screen.findByRole('region', { name: 'Последние документы' }))
+    await documents.findByRole('heading', { name: 'Нет доступа' })
+    expect(documents.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    expect(screen.getByText('Healthy task')).toBeInTheDocument()
+    expect(screen.queryByRole('link', { name: 'Найти' })).not.toBeInTheDocument()
+    expect(screen.queryByRole('link', { name: 'Новый документ' })).not.toBeInTheDocument()
+  })
 })
