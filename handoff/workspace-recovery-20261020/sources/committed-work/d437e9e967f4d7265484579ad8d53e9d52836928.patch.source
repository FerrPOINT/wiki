+        '<h3>Третий уровень</h3><h4>Четвёртый уровень</h4><h5>Пятый уровень</h5><h6>Шестой уровень</h6>',
+        longContentHtml,
+      ].join('')
+      const revision = { ...document.current_revision, body_html: html }
+      await page.route(
+        /\/api\/v1\/documents\/product-requirements(?:\/revisions(?:\/[^/?]+)?)?$/,
+        async (route) => {
+          if (route.request().method() !== 'GET') return route.fallback()
+          const path = new URL(route.request().url()).pathname
+          return routeJson(
+            route,
+            path.endsWith('/revisions')
+              ? { revisions: [revision] }
+              : path.endsWith('/product-requirements')
+                ? { ...document, body_html: html, current_revision: revision }
+                : revision,
+          )
+        },
+      )
+
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        await gotoWiki(page, '/documents/product-requirements?space=BASE&source=headings')
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        for (const mode of ['published', 'revision'] as const) {
+          const trigger = page.getByRole('button', { name: 'Открыть ревизию 1' })
+          if (mode === 'revision') await trigger.click()
+          const dialog = page.getByRole('dialog', { name: 'Снимок ревизии' })
+          const body =
+            mode === 'revision'
+              ? dialog.locator('.wiki-rendered')
+              : page.locator('article .wiki-rendered')
+          await expect(
+            body.getByRole('heading', { name: 'Раздел документа', level: 3 }),
+          ).toBeVisible()
+          expect(
+            await body
+              .locator('h1, h2, h3, h4, h5, h6')
+              .evaluateAll((headings) => headings.map((heading) => heading.tagName)),
+          ).toEqual(['H3', 'H4', 'H5', 'H6', 'H6', 'H6', 'H3'])
+          await expect(page.locator('h1')).toHaveCount(1)
+          await expect(body.locator('#content-intro em')).toHaveText('Раздел документа')
+          await expect(body.locator('#content-section a')).toHaveAttribute('href', '#content-intro')
+          if (mode === 'revision') {
+            if (width === 375)
+              await testInfo.attach(`revision-width-${theme}`, {
+                body: JSON.stringify(
+                  await body.evaluate((element) => {
+                    const nodes: Record<string, unknown>[] = []
+                    for (
+                      let node: HTMLElement | null = element as HTMLElement;
+                      node;
+                      node = node.parentElement
+                    ) {
+                      const style = getComputedStyle(node)
+                      nodes.push({
+                        tag: node.tagName,
+                        className: node.className,
+                        width: node.clientWidth,
+                        scrollWidth: node.scrollWidth,
+                        minWidth: style.minWidth,
+                        cssWidth: style.width,
+                        display: style.display,
+                        columns: style.gridTemplateColumns,
+                        overflowX: style.overflowX,
+                      })
+                      if (node.matches('[role="dialog"]')) break
+                    }
+                    return nodes
+                  }),
+                ),
+                contentType: 'application/json',
+              })
+            const bounds = await dialog.boundingBox()
+            expect(bounds).not.toBeNull()
+            expect(bounds!.x).toBeGreaterThanOrEqual(0)
+            expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(width + 1)
+            expect(
+              await dialog.evaluate((element) => element.scrollWidth - element.clientWidth),
+            ).toBeLessThanOrEqual(1)
+          }
+          for (const region of [body.locator('pre'), body.locator('table')]) {
+            await expect(region).toHaveAttribute('tabindex', '0')
+            await region.focus()
+            await expect(region).toBeFocused()
+            if (width === 375) {
+              await testInfo.attach(
+                `scroll-region-${mode}-${theme}-${await region.evaluate((element) => element.tagName)}`,
+                {
+                  body: JSON.stringify(
+                    await region.evaluate((element) => ({
+                      tag: element.tagName,
+                      clientWidth: element.clientWidth,
+                      scrollWidth: element.scrollWidth,
+                      scrollLeft: element.scrollLeft,
+                      overflowX: getComputedStyle(element).overflowX,
+                      whiteSpace: getComputedStyle(element).whiteSpace,
+                      wordBreak: getComputedStyle(element).wordBreak,
+                      overflowWrap: getComputedStyle(element).overflowWrap,
+                      focused: element === document.activeElement,
+                    })),
+                  ),
+                  contentType: 'application/json',
+                },
+              )
+              expect(
+                await region.evaluate((element) => element.scrollWidth - element.clientWidth),
+              ).toBeGreaterThan(0)
+              await expect
+                .poll(async () => {
+                  await region.press('ArrowRight')
+                  return region.evaluate((element) => element.scrollLeft)
+                })
+                .toBeGreaterThan(0)
+            }
+          }
+          expect(
+            await page.evaluate(() => document.documentElement.scrollWidth - innerWidth),
+          ).toBeLessThanOrEqual(1)
+          if (width === 375 || width === 1920) {
+            await page.screenshot({
+              path: testInfo.outputPath(`document-headings-${mode}-${theme}-${width}.png`),
+              fullPage: true,
+            })
+          }
+          if (mode === 'revision') {
+            await page.keyboard.press('Escape')
+            await expect(dialog).toBeHidden()
+            await expect(trigger).toBeFocused()
+          }
+        }
+        await page.reload()
+        await expect(
+          page.getByRole('heading', { name: 'Требования к Wiki MVP', level: 1 }),
+        ).toBeVisible()
+        await expect(page.locator('h1')).toHaveCount(1)
+        await expect(page).toHaveURL(
+          `${baseURL}/documents/product-requirements?space=BASE&source=headings`,
+        )
+      }
+      expect(writes).toEqual([])
+      expect(errors).toEqual([])
+    })
+  }
