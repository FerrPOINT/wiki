+  const renderedHtml = useMemo(() => {
+    const body = new DOMParser().parseFromString(html, 'text/html').body
+    // Content sits below the page title and its section heading, not beside them.
+    for (const heading of body.querySelectorAll('h1, h2, h3, h4, h5, h6')) {
+      const level = Math.min(Number(heading.tagName.slice(1)) + 2, 6)
+      const nestedHeading = body.ownerDocument.createElement(`h${level}`)
+      for (const attribute of heading.attributes) {
+        nestedHeading.setAttribute(attribute.name, attribute.value)
+      }
+      nestedHeading.append(...heading.childNodes)
+      heading.replaceWith(nestedHeading)
+    }
+    for (const region of body.querySelectorAll<HTMLElement>('pre, table')) {
       region.tabIndex = 0
     }
-  })
+    return body.innerHTML
+  }, [html])
 
