diff --git a/frontend/src/shared/auth/require-auth.tsx b/frontend/src/shared/auth/require-auth.tsx
index 0abcdba..e75aadb 100644
--- a/frontend/src/shared/auth/require-auth.tsx
+++ b/frontend/src/shared/auth/require-auth.tsx
@@ -1,7 +1,5 @@
-// Route guard from @sdlc/ui/auth: one silent refresh, then /login.
-// Wiki keeps the access token in memory only; on a hard navigation the guard
-// performs a single silent refresh (cookie/localStorage refresh token) before
-// redirecting, so full page loads of protected routes stay authenticated.
+// Central SSO guard: the access token remains in memory; a hard navigation
+// returns to /login and the Central session restores it through PKCE.
 import { RequireAuth as Guard } from '@sdlc/ui/auth'
 import { useAuthStore } from '@/shared/auth/store'
 
