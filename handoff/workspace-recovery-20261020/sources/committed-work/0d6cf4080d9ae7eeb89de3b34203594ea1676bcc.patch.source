 describe('SpacesPage', () => {
+  it.each([403, 404])('hides cached spaces and mutation controls after HTTP %s', (status) => {
+    setupSpaces({
+      spacesOverrides: {
+        isLoading: true,
+        isError: true,
+        error: new ApiError({ status, statusText: 'Synthetic denial' }),
+      },
+    })
+    expect(
+      document.querySelector(
+        `[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`,
+      ),
+    ).toBeInTheDocument()
+    expect(screen.queryByText('База знаний Base')).not.toBeInTheDocument()
+    expect(
+      screen.queryByRole('button', { name: /Создать|Архивировать|Сохранить|Повторить/ }),
+    ).not.toBeInTheDocument()
+    expect(createMutate).not.toHaveBeenCalled()
+    expect(updateMutate).not.toHaveBeenCalled()
+    expect(archiveMutate).not.toHaveBeenCalled()
+  })
   afterEach(() => {
     vi.clearAllMocks()
   })
