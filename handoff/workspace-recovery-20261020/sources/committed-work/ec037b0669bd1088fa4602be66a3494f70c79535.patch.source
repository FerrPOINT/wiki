diff --git a/backend/api/tests/wiki_mvp.rs b/backend/api/tests/wiki_mvp.rs
index 7355992..e71c7f6 100644
--- a/backend/api/tests/wiki_mvp.rs
+++ b/backend/api/tests/wiki_mvp.rs
