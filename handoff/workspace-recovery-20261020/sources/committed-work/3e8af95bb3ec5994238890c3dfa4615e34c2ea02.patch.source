+  test('retains space URL context and drafts through collapse, reload and history', async ({
+    page,
+  }, testInfo) => {
+    await installWikiApiMocks(page)
+    await gotoWiki(page, '/spaces?status=active&sort=name&owner=mine&expanded=BASE&keep=yes')
+    const row = page.getByRole('button', { name: /База знаний Base/ })
+    await expect(row).toHaveAttribute('aria-expanded', 'true')
+    await expect(page.getByRole('combobox', { name: 'Статус пространства' })).toHaveValue('active')
+    await expect(page.getByRole('combobox', { name: 'Сортировка пространств' })).toHaveValue('name')
+    await expect(page.getByRole('checkbox', { name: 'Только мои' })).toBeChecked()
+    await page.reload()
+    await expect(row).toHaveAttribute('aria-expanded', 'true')
+    await expect(
+      page.getByRole('link', { name: 'Требования к Wiki MVP требования' }),
+    ).toHaveAttribute('href', '/documents/product-requirements?space=BASE')
+    await page
+      .getByRole('textbox', { name: 'Название пространства' })
+      .fill('Несохранённое название')
+    await row.click()
+    await expect(page).not.toHaveURL(/expanded=/)
+    await page.goBack()
+    await expect(row).toHaveAttribute('aria-expanded', 'true')
+    await expect(page.getByRole('textbox', { name: 'Название пространства' })).toHaveValue(
+      'Несохранённое название',
+    )
+    for (const width of [375, 1920, 2560]) {
+      await page.setViewportSize({ width, height: 1080 })
+      await expect
+        .poll(() =>
+          page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        )
+        .toBe(true)
+      const controls = await page
+        .locator('main')
+        .locator(
+          'button:visible,input:visible:not([type="checkbox"]),select:visible,textarea:visible',
+        )
+        .evaluateAll((elements) =>
+          elements.map((element) => ({
+            label: element.getAttribute('aria-label') ?? element.textContent,
+            height: element.getBoundingClientRect().height,
+          })),
+        )
+      expect(controls.filter((control) => control.height < (width < 768 ? 44 : 40) - 0.5)).toEqual(
+        [],
+      )
+      await page.screenshot({
+        path: testInfo.outputPath(`spaces-expanded-draft-${width}.png`),
+        fullPage: true,
+      })
+    }
+    await page.getByRole('link', { name: 'Поиск', exact: true }).click()
+    const dialog = page.getByRole('alertdialog')
+    await expect(dialog).toContainText('Несохранённые изменения')
+    await dialog.getByRole('button', { name: 'Отмена' }).click()
+    await expect(page.getByRole('textbox', { name: 'Название пространства' })).toHaveValue(
+      'Несохранённое название',
+    )
+  })
+
+  test('keeps a pending space write locked across collapse and retains the draft after failure', async ({
+    page,
+  }) => {
+    await installWikiApiMocks(page)
+    let requests = 0
+    let release!: () => void
+    const gate = new Promise<void>((resolve) => {
+      release = resolve
+    })
+    await page.route('**/api/v1/spaces/BASE', async (route) => {
+      if (route.request().method() !== 'PUT') return route.fallback()
+      requests += 1
+      await gate
+      await routeJson(
+        route,
+        { code: 'SERVICE_UNAVAILABLE', message: 'Сохранение временно недоступно' },
+        503,
+      )
+    })
+    try {
+      await gotoWiki(page, '/spaces?expanded=BASE')
+      await page
+        .getByRole('textbox', { name: 'Название пространства' })
+        .fill('Черновик после ошибки')
+      await page.getByRole('button', { name: 'Сохранить', exact: true }).click()
+      await expect.poll(() => requests).toBe(1)
+      const row = page.getByRole('button', { name: /База знаний Base/ })
+      await row.click()
+      await row.click()
+      const form = page.getByRole('form', { name: 'Изменение пространства BASE' })
+      await expect(form.getByRole('textbox', { name: 'Название пространства' })).toBeDisabled()
+      await expect(form.getByRole('button', { name: 'Сохраняем...' })).toBeDisabled()
+      await form.dispatchEvent('submit')
+      expect(requests).toBe(1)
+      release()
+      await expect(form.getByRole('alert')).toContainText('Сохранение временно недоступно')
+      await expect(form.getByRole('textbox', { name: 'Название пространства' })).toHaveValue(
+        'Черновик после ошибки',
+      )
+      await expect(form.getByRole('textbox', { name: 'Название пространства' })).toBeEnabled()
+    } finally {
+      release()
+    }
+  })
+
   test('keeps long published Markdown inside the viewport with keyboard-scrollable regions', async ({
     page,
   }) => {
