diff --git a/docs/USER_GUIDE.md b/docs/USER_GUIDE.md
index a8769d5..d136a34 100644
--- a/docs/USER_GUIDE.md
+++ b/docs/USER_GUIDE.md
@@ -69,11 +69,15 @@ Wiki хранит важные материалы вокруг SDLC-задач:
 - phase dossier по workflow-фазе;
 - evidence по типу источника или ссылке.
 
-## 8. Права
+## 8. Аудит
+
+На странице `/audit-log` фильтруйте события по действию, типу объекта, участнику и периоду. Время в полях периода вводится по местному часовому поясу; конечная дата не включается. Кнопка «Сбросить» возвращает полную историю. Для расследования доступны исходный код действия, идентификаторы объекта и запроса.
+
+## 9. Права
 
 Viewers видят опубликованный контент. Editors создают черновики, публикуют ревизии и прикрепляют evidence. Space admins управляют участниками и metadata своего пространства. System admins управляют пользователями, шаблонами, настройками и аудитом.
 
-## 9. CLI
+## 10. CLI
 
 `wiki` CLI - второй официальный клиент к тому же публичному API, который использует UI. Он нужен для scripted document creation, task/phase evidence capture, администрирования users/members, чтения audit log и скачивания attachments.
 
diff --git a/frontend/src/api/wiki-audit-filters.test.ts b/frontend/src/api/wiki-audit-filters.test.ts
new file mode 100644
index 0000000..4a1185b
--- /dev/null
+++ b/frontend/src/api/wiki-audit-filters.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { listAuditLog } from './wiki'
+
+const apiRequest = vi.hoisted(() => vi.fn())
+
+vi.mock('./client', () => ({ apiRequest, apiBlobRequest: vi.fn() }))
+
+describe('listAuditLog', () => {
+  it('serializes exact server filters before cursor pagination', async () => {
+    await listAuditLog({
+      limit: 20,
+      cursor: 'next page',
+      action: 'document.publish',
+      entity_type: 'document',
+      actor_id: '00000000-0000-4000-8000-000000000001',
+      from: '2026-09-20T07:00:00.000Z',
+      to: '2026-09-21T07:00:00.000Z',
+    })
+
+    const url = new URL(apiRequest.mock.calls[0]![0], 'http://wiki.local')
+    expect(url.pathname).toBe('/api/v1/audit-log')
+    expect(Object.fromEntries(url.searchParams)).toEqual({
+      limit: '20',
+      cursor: 'next page',
+      action: 'document.publish',
+      entity_type: 'document',
+      actor_id: '00000000-0000-4000-8000-000000000001',
+      from: '2026-09-20T07:00:00.000Z',
+      to: '2026-09-21T07:00:00.000Z',
+    })
+  })
+
+  it('omits cleared filters', async () => {
+    await listAuditLog({ limit: 20, action: '', entity_type: '', actor_id: '', from: '', to: '' })
+
+    expect(apiRequest).toHaveBeenLastCalledWith('/api/v1/audit-log?limit=20')
+  })
+})
