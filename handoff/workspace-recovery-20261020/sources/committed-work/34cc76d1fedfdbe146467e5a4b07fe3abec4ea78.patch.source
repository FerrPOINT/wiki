diff --git a/frontend/src/pages/users/users.test.tsx b/frontend/src/pages/users/users.test.tsx
index a682a08..66ffe14 100644
--- a/frontend/src/pages/users/users.test.tsx
+++ b/frontend/src/pages/users/users.test.tsx
@@ -97,9 +97,9 @@ describe('UsersPage', () => {
     setupUsers({
       data: undefined,
       isError: true,
-      error: { code: 'FORBIDDEN', message: 'Forbidden' },
+      error: { status: 503, code: 'UNAVAILABLE', message: 'Не удалось загрузить пользователей' },
     })
-    expect(screen.getByRole('alert')).toHaveTextContent('Недостаточно прав для действия')
+    expect(screen.getByRole('alert')).toHaveTextContent('Не удалось загрузить пользователей')
     fireEvent.click(screen.getByRole('button', { name: 'Повторить' }))
     expect(usersRefetch).toHaveBeenCalled()
     expect(screen.getByRole('textbox', { name: 'Поиск пользователей' })).toBeInTheDocument()
@@ -177,4 +177,25 @@ describe('UsersPage', () => {
     expect(screen.getByRole('button', { name: 'Назад' })).toHaveClass('min-h-10', 'sm:min-h-10')
     expect(screen.getByRole('button', { name: 'Далее' })).toHaveClass('min-h-10', 'sm:min-h-10')
   })
+
+  it.each([403, 404])('uses terminal Base state for %s and keeps URL context', (status) => {
+    setupUsers({ isError: true, error: { status } }, '/users?keep=1&q=anna')
+    expect(
+      document.querySelector(
+        `[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`,
+      ),
+    ).toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    expect(screen.queryByRole('textbox', { name: 'Поиск пользователей' })).not.toBeInTheDocument()
+    expect(screen.queryByRole('link', { name: 'Учётные записи' })).not.toBeInTheDocument()
+    expect(screen.queryByText('Анна')).not.toBeInTheDocument()
+    expect(screen.getByTestId('router-location')).toHaveTextContent('/users?keep=1&q=anna')
+  })
+
+  it('retains search but does not offer retry for invalid requests', () => {
+    setupUsers({ data: undefined, isError: true, error: { status: 400 } })
+    expect(screen.getByRole('alert')).toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    expect(screen.getByRole('textbox', { name: 'Поиск пользователей' })).toBeInTheDocument()
+  })
 })
