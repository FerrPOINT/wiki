+  test('shows cold audit actor and space labels with secondary diagnostic IDs', async ({
+    page,
+  }) => {
+    await installWikiApiMocks(page)
+    const errors: string[] = []
+    const lookupPaths: string[] = []
+    page.on('pageerror', (error) => errors.push(error.message))
+    page.on('request', (request) => {
+      const path = new URL(request.url()).pathname
+      if (request.method() === 'GET' && path.startsWith('/api/v1/')) lookupPaths.push(path)
+    })
+    await gotoWiki(page, '/audit-log')
+    const events = page.getByRole('region', { name: 'События аудита' })
+    await expect(events.getByText('Администратор', { exact: true }).last()).toBeVisible()
+    await expect(events.getByText('База знаний Base', { exact: true }).last()).toBeVisible()
+    await expect(page.getByRole('button', { name: 'Фильтры' })).toHaveAttribute(
+      'aria-expanded',
+      'false',
+    )
+    const diagnostics = events.locator('details:visible')
+    await expect(diagnostics).not.toHaveAttribute('open')
+    await expect(events.getByText('mock-request', { exact: true }).last()).toBeHidden()
+    await diagnostics.locator('summary').focus()
+    await page.keyboard.press('Enter')
+    await expect(diagnostics.getByText(user.id, { exact: true })).toBeVisible()
+    await expect(diagnostics.getByText('mock-request', { exact: true })).toBeVisible()
+    expect(lookupPaths.filter((path) => path === '/api/v1/users')).toHaveLength(1)
+    expect(lookupPaths.filter((path) => path === '/api/v1/spaces')).toHaveLength(1)
+    expect(lookupPaths.some((path) => path.startsWith('/api/v1/documents/'))).toBe(false)
+    expect(errors).toEqual([])
+  })
+
   test('keeps the platform shell active-route and keyboard drawer contract', async ({ page }) => {
     await page.setViewportSize({ width: 375, height: 812 })
     await installWikiApiMocks(page)
