diff --git a/frontend/src/pages/settings/settings.test.tsx b/frontend/src/pages/settings/settings.test.tsx
index ab85260..97eaaeb 100644
--- a/frontend/src/pages/settings/settings.test.tsx
+++ b/frontend/src/pages/settings/settings.test.tsx
@@ -78,4 +78,39 @@ describe('SettingsPage', () => {
     expect(screen.getByText('Загружаем настройки')).toBeInTheDocument()
     expect(screen.queryByRole('region', { name: 'Инстанс' })).not.toBeInTheDocument()
   })
+
+  it.each([403, 404])(
+    'uses terminal Base state for %s without stale settings or retry',
+    (status) => {
+      useWikiSettings.mockReturnValue({
+        data: settings,
+        isLoading: false,
+        isError: true,
+        error: { status },
+        refetch: vi.fn(),
+      })
+      render(<SettingsPage />)
+      expect(
+        document.querySelector(
+          `[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`,
+        ),
+      ).toBeInTheDocument()
+      expect(screen.queryByRole('region', { name: 'Инстанс' })).not.toBeInTheDocument()
+      expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+      expect(screen.getByRole('heading', { name: 'Настройки' })).toHaveClass('base-page-title')
+    },
+  )
+
+  it('does not offer retry for invalid settings requests', () => {
+    useWikiSettings.mockReturnValue({
+      data: undefined,
+      isLoading: false,
+      isError: true,
+      error: { status: 400 },
+      refetch: vi.fn(),
+    })
+    render(<SettingsPage />)
+    expect(screen.getByRole('alert')).toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+  })
 })
