 test.describe('wiki smoke', () => {
+  test('restores search cursor context through SSO, reload, Back and Forward', async ({ page }) => {
+    await installWikiApiMocks(page)
+    const records = Array.from({ length: 41 }, (_, index) => ({
+      id: `search-${index + 1}`,
+      result_type: 'document',
+      title: `Документ поиска ${index + 1}`,
+      space_key: 'BASE',
+      url: `/documents/search-${index + 1}`,
+      snippet: 'Безопасные тестовые данные',
+      updated_at: now,
+    }))
+    await page.route('**/api/v1/search?*', (route) => {
+      const cursor = new URL(route.request().url()).searchParams.get('cursor')
+      const offset = cursor ? Number(cursor.slice(5)) : 0
+      return routeJson(route, {
+        results: records.slice(offset, offset + 20),
+        next_cursor: offset + 20 < records.length ? `page-${offset + 20}` : null,
+      })
+    })
+    const query = '/search?q=Wiki&keep=1&cursor=page-40&previous_cursor=page-20#results'
+    await gotoWiki(page, query)
+    await expect(page.getByText('Страница 3', { exact: true })).toBeVisible()
+    await expect(page.getByRole('link', { name: /Документ поиска 41/ })).toBeVisible()
+    await page.reload()
+    await expect(page).toHaveURL(`${baseURL}${query}`)
+    await expect(page.getByText('Страница 3', { exact: true })).toBeVisible()
+    await page.getByRole('button', { name: 'Назад', exact: true }).click()
+    await expect(page).toHaveURL(`${baseURL}/search?q=Wiki&keep=1&cursor=page-20#results`)
+    await expect(page.getByText('Показано 21–40', { exact: true })).toBeVisible()
+    await page.goBack()
+    await expect(page.getByText('Страница 3', { exact: true })).toBeVisible()
+    await page.goForward()
+    await expect(page.getByText('Страница 2', { exact: true })).toBeVisible()
+    await page.getByRole('searchbox', { name: 'Поисковый запрос' }).fill('релиз')
+    await expect(page).toHaveURL(
+      `${baseURL}/search?q=%D1%80%D0%B5%D0%BB%D0%B8%D0%B7&keep=1#results`,
+    )
+    await expect(page.getByText('Страница 1', { exact: true })).toBeVisible()
+    await page.goBack()
+    await expect(page.getByText('Страница 2', { exact: true })).toBeVisible()
+    await expect(page.getByRole('searchbox', { name: 'Поисковый запрос' })).toHaveValue('Wiki')
+    await page.getByRole('button', { name: 'Документы', exact: true }).click()
+    await expect(page).toHaveURL(`${baseURL}/search?q=Wiki&keep=1&result_type=document#results`)
+  })
+
+  test('uses Base search composition and controls across themes, widths and cached failures', async ({
+    page,
+  }, testInfo) => {
+    test.setTimeout(300_000)
+    await installWikiApiMocks(page)
+    let status = 200
+    await page.route('**/api/v1/search?*', (route) =>
+      status === 0
+        ? route.abort('failed')
+        : status === 200
+          ? route.fallback()
+          : routeJson(route, { message: 'Временный сбой тестового поиска' }, status),
+    )
+    const errors: string[] = []
+    page.on('pageerror', (error) => errors.push(error.message))
+    await gotoWiki(page, '/search')
+    for (const theme of ['dark', 'gray', 'light']) {
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      await page.reload()
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+        await page.getByRole('button', { name: 'Фильтры', exact: true }).click()
+        const targets = await page
+          .locator('main button, main input, main select')
+          .evaluateAll((elements) =>
+            elements
+              .filter((element) => element.getClientRects().length > 0)
+              .map((element) => ({
+                label: element.getAttribute('aria-label') ?? element.textContent,
+                height: element.getBoundingClientRect().height,
+              })),
+          )
+        expect(targets.length).toBeGreaterThan(5)
+        for (const target of targets)
+          expect(target.height, String(target.label)).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        if (width === 375 || width === 1920)
+          expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`search-${theme}-${width}.png`),
+          fullPage: true,
+        })
+        await page.getByRole('button', { name: 'Фильтры', exact: true }).click()
+      }
+    }
+    for (const failure of [0, 503, 403, 404, 422]) {
+      status = 200
+      await page.getByRole('link', { name: 'Пространства', exact: true }).click()
+      await page.getByRole('link', { name: 'Поиск', exact: true }).click()
+      await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+      status = failure
+      await page.getByRole('link', { name: 'Пространства', exact: true }).click()
+      await page.getByRole('link', { name: 'Поиск', exact: true }).click()
+      if (failure === 0 || failure === 503) {
+        await expect(page.locator('[data-page-state="partial-error"]')).toBeVisible({
+          timeout: 15_000,
+        })
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+        await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toBeVisible()
+      } else {
+        const error =
+          failure === 422
+            ? page.getByRole('alert')
+            : page.locator(
+                `[data-page-state="${failure === 403 ? 'permission-denied' : 'not-found'}"]`,
+              )
+        await expect(error).toBeVisible({ timeout: 15_000 })
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toHaveCount(0)
+        await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+      }
+      for (const width of [375, 1920]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`search-cached-${failure}-${width}.png`),
+          fullPage: true,
+        })
+      }
+    }
+    expect(errors).toEqual([])
+  })
+
   test('restores overview space context after direct login, reload and browser history', async ({
     page,
   }) => {
