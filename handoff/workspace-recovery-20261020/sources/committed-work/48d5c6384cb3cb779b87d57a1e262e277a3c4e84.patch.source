+    expect(router.state.location.search).toBe('?q=Wiki&keep=1&result_type=document')
+    await act(() => router.navigate('/search?q=Wiki&keep=1&cursor=page-40&previous_cursor=page-20'))
+    fireEvent.click(screen.getByRole('button', { name: 'Фильтры' }))
+    fireEvent.change(screen.getByLabelText('Пространство'), { target: { value: 'eng' } })
+    fireEvent.click(screen.getByRole('button', { name: 'Применить' }))
+    expect(router.state.location.search).toBe('?q=Wiki&keep=1&space=ENG')
+    await act(() =>
+      router.navigate('/search?q=Wiki&keep=1&space=ENG&cursor=page-40&previous_cursor=page-20'),
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'Сбросить фильтры' }))
+    expect(router.state.location.search).toBe('?q=Wiki&keep=1')
+    await act(() => router.navigate('/search?q=Wiki&keep=1&cursor=page-40&previous_cursor=page-20'))
+    fireEvent.change(screen.getByRole('searchbox', { name: 'Поисковый запрос' }), {
+      target: { value: 'новый' },
+    })
+    await waitFor(() =>
+      expect(router.state.location.search).toBe('?q=%D0%BD%D0%BE%D0%B2%D1%8B%D0%B9&keep=1'),
+    )
+    await act(() => router.navigate(-1))
+    expect(screen.getByRole('searchbox', { name: 'Поисковый запрос' })).toHaveValue('Wiki')
+    expect(useWikiSearch).toHaveBeenLastCalledWith(expect.objectContaining({ cursor: 'page-40' }))
+  })
+
+  it('canonicalizes cursor whitespace, duplicates and orphan history without losing unrelated params', () => {
+    const router = setupSearch(
+      undefined,
+      {},
+      '/search?keep=1&cursor=%20page-20%20&cursor=other&previous_cursor=%20&previous_cursor=%20page-10%20',
+    )
+    expect(router.state.location.search).toBe('?keep=1&cursor=page-20&previous_cursor=page-10')
+    expect(useWikiSearch).toHaveBeenLastCalledWith(expect.objectContaining({ cursor: 'page-20' }))
+  })
+
+  it('removes previous cursor history when there is no current cursor', () => {
+    const router = setupSearch(undefined, {}, '/search?keep=1&previous_cursor=page-20')
+    expect(router.state.location.search).toBe('?keep=1')
+    expect(useWikiSearch).toHaveBeenLastCalledWith(expect.objectContaining({ cursor: undefined }))
+  })
+
+  it.each([0, 408, 429, 503])(
+    'preserves results with a partial warning and retry for status %s',
+    (status) => {
+      setupSearch(undefined, {
+        isError: true,
+        error: { status, message: 'Временный сбой' },
+      })
+      expect(screen.getByRole('link', { name: /Требования Wiki/ })).toBeInTheDocument()
+      expect(screen.getByText('Временный сбой')).toBeInTheDocument()
+      expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+      fireEvent.click(screen.getByRole('button', { name: 'Повторить' }))
+      expect(searchRefetch).toHaveBeenCalledTimes(1)
+    },
+  )
+
+  it.each([404, 422])('hides cached results and retry for non-retryable status %s', (status) => {
+    setupSearch(undefined, { isError: true, error: { status, message: 'Ошибка запроса' } })
+    expect(screen.queryByRole('link', { name: /Требования Wiki/ })).not.toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    expect(screen.queryByText('Ничего не найдено')).not.toBeInTheDocument()
+  })
+
+  it('does not retain cached results or offer retry for cancellation', () => {
+    setupSearch(undefined, { isError: true, error: { name: 'AbortError' } })
+    expect(screen.queryByRole('link', { name: /Требования Wiki/ })).not.toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+  })
+
+  it('keeps previous page available when the next page fails without cached data', () => {
+    setupSearch(
+      [],
+      { data: undefined, isError: true, error: { status: 503 } },
+      '/search?keep=1&cursor=page-20',
+    )
+    expect(screen.getByRole('button', { name: 'Назад' })).toBeEnabled()
+    expect(screen.getByRole('button', { name: 'Далее' })).toBeDisabled()
   })
 })
