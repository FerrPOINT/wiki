 +    await gotoWiki(page, '/search?space=team&keep=1#results')
 +    const create = page.getByRole('link', { name: 'Новый документ', exact: true })
 +    const geometry: Array<{ theme: string; width: number; height: number }> = []
 +    for (const theme of ['light', 'gray', 'dark']) {
 +      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
 +      await page.reload()
 +      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
 +        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
 +        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
 +        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
 +        await expect(create).toHaveCount(1)
 +        await expect(create).toBeVisible()
 +        await expect(create).toHaveAttribute('href', '/documents/new?space=TEAM')
 +        await expect(
 +          page.locator('.base-page-actions').getByRole('link', {
 +            name: 'Новый документ',
 +            exact: true,
 +          }),
 +        ).toHaveCount(1)
 +        await expect(
 +          page.locator('[data-platform-header]').getByRole('link', {
 +            name: 'Новый документ',
 +            exact: true,
 +          }),
 +        ).toHaveCount(0)
 +        const target = await create.boundingBox()
 +        expect(target).not.toBeNull()
 +        expect(target!.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
 +        expect(target!.x).toBeGreaterThanOrEqual(0)
 +        expect(target!.x + target!.width).toBeLessThanOrEqual(width)
 +        expect(
 +          await page.evaluate(
 +            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
 +          ),
 +        ).toBe(true)
 +        geometry.push({ theme, width, height: target!.height })
 +        if (width < 768) {
 +          const trigger = page.getByRole('button', { name: 'Открыть навигацию' })
 +          await trigger.click()
 +          const drawer = page.getByRole('dialog', { name: 'Wiki', exact: true })
 +          await expect(
 +            drawer.getByRole('link', { name: 'Новый документ', exact: true }),
 +          ).toHaveCount(0)
