 +    await create.focus()
 +    await expect(create).toBeFocused()
 +    await page.keyboard.press('Enter')
 +    await expect(page).toHaveURL(`${baseURL}/documents/new?space=TEAM`)
 +    await expect(page.getByRole('combobox', { name: 'Пространство', exact: true })).toHaveValue(
