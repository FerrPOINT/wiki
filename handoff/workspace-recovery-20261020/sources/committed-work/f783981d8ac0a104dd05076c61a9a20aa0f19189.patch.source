 +                .filter(
 +                  (control) => control.getClientRects().length && !control.closest('[hidden]'),
 +                )
 +                .every(
 +                  (control) =>
 +                    control.getBoundingClientRect().height >= (innerWidth < 768 ? 44 : 40),
 +                ),
 +            ),
 +          )
 +          .toBe(true)
 +        const measurements = await main.evaluate((element) => {
 +          const split = element.querySelector('.page-split')!
 +          const aside = split.querySelector('aside')!
 +          const content = split.firstElementChild!
 +          const controls = Array.from(
 +            element.querySelectorAll('input, select, button, [role="tab"]'),
 +          ).filter((control) => control.getClientRects().length && !control.closest('[hidden]'))
 +          return {
 +            fits: document.documentElement.scrollWidth <= document.documentElement.clientWidth,
 +            aside: aside.getBoundingClientRect().width,
 +            stacked: aside.getBoundingClientRect().top >= content.getBoundingClientRect().bottom,
 +            targets: controls.map((control) => ({
 +              label: control.getAttribute('aria-label') ?? control.textContent ?? control.id,
 +              height: control.getBoundingClientRect().height,
 +              minHeight: getComputedStyle(control).minHeight,
 +            })),
 +          }
 +        })
 +        expect(measurements.fits).toBe(true)
 +        await expect
 +          .poll(() =>
