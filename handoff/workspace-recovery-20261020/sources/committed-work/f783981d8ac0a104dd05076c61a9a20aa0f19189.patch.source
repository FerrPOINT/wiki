 +  test('validates search page creation context across Base themes and shell boundaries', async ({
 +    page,
 +  }, testInfo) => {
 +    test.setTimeout(180_000)
 +    await installWikiApiMocks(page)
 +    const teamSpace = { ...baseSpace, id: 'space-team', key: 'TEAM', name: 'Команда' }
 +    let spaces = [teamSpace, baseSpace]
 +    let catalogStatus = 200
 +    let identityActive = true
 +    let identityStatus = 200
 +    let searchStatus = 200
 +    const errors: string[] = []
 +    const responses: Array<{ path: string; status: number }> = []
 +    page.on('pageerror', (error) => errors.push(error.message))
 +    page.on('response', (response) => {
 +      const path = new URL(response.url()).pathname
 +      if (path.startsWith('/api/v1/')) responses.push({ path, status: response.status() })
 +    })
 +    await page.route('**/api/v1/spaces', (route) =>
 +      routeJson(
 +        route,
 +        catalogStatus === 200
 +          ? { spaces }
 +          : { code: 'SERVICE_UNAVAILABLE', message: 'Catalog unavailable' },
 +        catalogStatus,
 +      ),
 +    )
 +    await page.route('**/api/v1/users/me', (route) => {
 +      // Keep the mocked login successful; vary only the post-login profile query.
 +      if (new URL(page.url()).pathname === '/sso/callback') return routeJson(route, user)
 +      return routeJson(
 +        route,
 +        identityStatus === 200
 +          ? { ...user, active: identityActive }
 +          : { code: 'SERVICE_UNAVAILABLE', message: 'Identity unavailable' },
 +        identityStatus,
 +      )
 +    })
 +    await page.route('**/api/v1/search**', (route) =>
 +      searchStatus === 200
 +        ? route.fallback()
 +        : routeJson(
