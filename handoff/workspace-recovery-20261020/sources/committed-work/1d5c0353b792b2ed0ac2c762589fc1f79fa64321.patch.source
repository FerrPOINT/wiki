         await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
       }
-      for (const width of [375, 1920]) {
+      for (const width of [375, 1920, 2560]) {
         await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
         expect(
           await page.evaluate(
@@ -711,6 +714,67 @@ test.describe('wiki smoke', () => {
           fullPage: true,
         })
       }
+      if (failure === 0) {
+        status = 200
+        await page.getByRole('button', { name: 'Повторить', exact: true }).click()
+        await expect(page.locator('[data-page-state="partial-error"]')).toHaveCount(0)
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+      }
+    }
+    expect(errors).toEqual([])
+  })
+
+  test('localizes an initial transport failure and recovers with URL context intact', async ({
+    page,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    await installWikiApiMocks(page)
+    let fail = true
+    let searchRequests = 0
+    await page.route('**/api/v1/search?*', (route) => {
+      searchRequests++
+      return fail ? route.abort('failed') : route.fallback()
+    })
+    const errors: string[] = []
+    page.on('pageerror', (error) => errors.push(error.message))
+    const path = '/search?q=Wiki&space=BASE&keep=1#results'
+    await gotoWiki(page, path)
+    for (const theme of ['dark', 'gray', 'light']) {
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      for (const width of [375, 1440, 1920, 2560]) {
+        fail = true
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        const attemptsBeforeLoad = searchRequests
+        await page.reload()
+        await expect.poll(() => searchRequests).toBeGreaterThan(attemptsBeforeLoad)
+        const error = page.getByRole('alert')
+        await expect(error).toContainText('Не удалось выполнить поиск', { timeout: 15_000 })
+        await expect(page.locator('main')).not.toContainText('Failed to fetch')
+        await expect(page.locator('[data-page-state="empty"]')).toHaveCount(0)
+        await expect(page.locator('[data-page-state="partial-error"]')).toHaveCount(0)
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toHaveCount(0)
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`search-initial-network-${theme}-${width}.png`),
+          fullPage: true,
+        })
+        const attemptsBeforeRetry = searchRequests
+        fail = false
+        const retry = page.getByRole('button', { name: 'Повторить', exact: true })
+        await retry.focus()
+        await retry.press('Enter')
+        await expect(error).toHaveCount(0)
+        await expect(page.getByRole('link', { name: /Требования к Wiki MVP/ })).toBeVisible()
+        expect(searchRequests).toBeGreaterThan(attemptsBeforeRetry)
+        await expect(page).toHaveURL(`${baseURL}${path}`)
+        await expect(page.getByRole('searchbox', { name: 'Поисковый запрос' })).toHaveValue('Wiki')
+      }
     }
     expect(errors).toEqual([])
   })
