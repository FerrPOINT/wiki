+  it('localizes a native fetch rejection without discarding cached results or losing retry', () => {
+    setupSearch(undefined, { isError: true, error: new TypeError('Failed to fetch') })
+
+    expect(screen.getByText('Не удалось выполнить поиск')).toBeInTheDocument()
