+
+    expect(formatApiErrorForUser(error, 'fallback')).toBe(
+      'Документ нельзя связать: Пространство: другое пространство',
+    )
+    expect(hasApiErrorCode(error, 'INVALID_DOCUMENT_LINK')).toBe(true)
+  })
+
   it('uses the fallback when the API error has no useful message', () => {
     expect(formatApiErrorForUser({ code: 'UNKNOWN', message: '' }, 'Не удалось')).toBe('Не удалось')
   })
@@ -47,6 +90,15 @@ describe('formatApiErrorForUser', () => {
     expect(formatFirstApiErrorForUser([null, undefined, false], 'fallback')).toBe('')
   })
 
+  it('uses the fallback for the first native error in aggregate page queries', () => {
