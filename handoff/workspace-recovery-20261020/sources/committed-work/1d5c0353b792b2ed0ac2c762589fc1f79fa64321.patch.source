     expect(hasApiErrorCode({ code: 'FORBIDDEN' }, 'CONFLICT')).toBe(false)
diff --git a/frontend/src/shared/lib/api-error.ts b/frontend/src/shared/lib/api-error.ts
index 4baf55d..8e35ea8 100644
--- a/frontend/src/shared/lib/api-error.ts
+++ b/frontend/src/shared/lib/api-error.ts
@@ -7,6 +7,7 @@ type ApiErrorLike = {
   code?: unknown
   details?: unknown
   message?: unknown
+  status?: unknown
 }
 
 const codeMessages: Record<string, string> = {
@@ -59,7 +60,15 @@ export function hasApiErrorCode(error: unknown, expectedCode: string): boolean {
 
 function readApiErrorLike(error: unknown): ApiErrorLike | null {
   if (!error || typeof error !== 'object') return null
-  return error as ApiErrorLike
+  const apiError = error as ApiErrorLike
+  if (apiError.status === 0) return null
+  const isHttpError =
+    typeof apiError.status === 'number' &&
+    Number.isInteger(apiError.status) &&
+    apiError.status >= 400 &&
+    apiError.status <= 599
+  // Native fetch/JSON errors are diagnostics, not a server error envelope.
+  return readString(apiError.code) || isHttpError ? apiError : null
 }
 
 function readString(value: unknown): string {
