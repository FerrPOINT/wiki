+        isError: true,
+        error,
+      })
+      renderAuditLog()
+
+      expect(screen.getByRole('alert')).toBeInTheDocument()
+      expect(document.querySelector('[data-page-state="partial-error"]')).not.toBeInTheDocument()
+      expect(screen.queryByText('Опубликован документ')).not.toBeInTheDocument()
+      expect(screen.queryByText('Событий аудита пока нет')).not.toBeInTheDocument()
+      expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    },
+  )
 
   it('does not offer retry for a non-repeatable request error', () => {
     useAuditLog.mockReturnValue({
