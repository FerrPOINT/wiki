diff --git a/frontend/e2e/smoke.spec.ts b/frontend/e2e/smoke.spec.ts
index 048b8f3..bdcbdd7 100644
--- a/frontend/e2e/smoke.spec.ts
+++ b/frontend/e2e/smoke.spec.ts
@@ -978,6 +978,70 @@ test.describe('wiki smoke', () => {
     }
   })
 
+  test('uses the Base cached audit error policy without hiding repeatable failures', async ({
+    page,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    await installWikiApiMocks(page)
+    let status = 200
+    await page.route('**/api/v1/audit-log*', async (route) => {
+      if (status === 200) return route.fallback()
+      if (status === 0) return route.abort('failed')
+      return routeJson(
+        route,
+        {
+          code: status === 422 ? 'VALIDATION_ERROR' : 'SERVICE_UNAVAILABLE',
+          message: 'Audit refresh rejected',
+        },
+        status,
+      )
+    })
+    for (const failure of [0, 408, 429, 503, 403, 404, 422]) {
+      status = 200
+      await gotoWiki(page, '/spaces')
+      await page.getByRole('link', { name: 'Аудит', exact: true }).click()
+      const events = page.getByRole('region', { name: 'События аудита' })
+      await expect(events.getByText('Создана начальная структура').last()).toBeVisible()
+      status = failure
+      await page.getByRole('link', { name: 'Пространства', exact: true }).click()
+      await page.getByRole('link', { name: 'Аудит', exact: true }).click()
+      const repeatable = [0, 408, 429, 503].includes(failure)
+      const state = repeatable
+        ? 'partial-error'
+        : failure === 403
+          ? 'permission-denied'
+          : failure === 404
+            ? 'not-found'
+            : 'error'
+      await expect(
+        state === 'error'
+          ? events.getByRole('alert')
+          : events.locator(`[data-page-state="${state}"]`),
+      ).toBeVisible({ timeout: 15_000 })
+      if (repeatable) {
+        await expect(events.getByText('Создана начальная структура').last()).toBeVisible()
+        await expect(events.getByRole('button', { name: 'Повторить', exact: true })).toBeVisible()
+      } else {
+        await expect(events.getByText('Создана начальная структура')).toHaveCount(0)
+        await expect(events.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+      }
+      await expect(events.getByText('Событий аудита пока нет')).toHaveCount(0)
+      for (const width of [375, 1920, 2560]) {
+        await page.setViewportSize({ width, height: width < 768 ? 812 : 1080 })
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`audit-cached-${failure}-${width}.png`),
+          fullPage: true,
+        })
+      }
+    }
+  })
+
   test('shows cold audit actor and space labels with secondary diagnostic IDs', async ({
     page,
   }) => {
