# Wiki — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.
#
# Env var format: WIKI_SECTION__KEY (double underscore = nested key)
# Special: WIKI_JWT_SECRET (backwards-compat alias for auth.jwt_secret)

# PostgreSQL
# Host-side local run with compose Postgres uses localhost:3457.
# A backend container with PostgreSQL persistence should use postgres:5432 instead.
WIKI_DATABASE__URL=postgres://wiki:[CHANGE_ME]@localhost:3457/wiki
WIKI_DATABASE__MAX_CONNECTIONS=20
WIKI_DATABASE__MIN_CONNECTIONS=5
WIKI_DATABASE__CONNECT_TIMEOUT_SECONDS=10
WIKI_DATABASE__IDLE_TIMEOUT_SECONDS=600

# JWT / Auth
WIKI_JWT_SECRET=[CHANGE_ME]
WIKI_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
WIKI_AUTH__REFRESH_TOKEN_TTL_DAYS=7
WIKI_AUTH__REFRESH_COOKIE_NAME=refresh_token
WIKI_AUTH__REFRESH_COOKIE_SECURE=true
WIKI_AUTH__REFRESH_COOKIE_SAME_SITE=Lax
WIKI_AUTH__REFRESH_COOKIE_PATH=/api/v1/auth

# Server
WIKI_SERVER__ADDRESS=0.0.0.0
WIKI_SERVER__PORT=3456
WIKI_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:19877,http://localhost:5173

# Storage (file uploads)
WIKI_STORAGE__DIR=/var/lib/wiki/uploads
WIKI_STORAGE__MAX_UPLOAD_BYTES=26214400

# Rust logging
RUST_LOG=info
