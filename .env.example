# Wiki — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.
#
# Env var format: WIKI_SECTION__KEY (double underscore = nested key)
# Special: WIKI_JWT_SECRET (backwards-compat alias for auth.jwt_secret)

# Runtime mode: development, test, staging, production.
# Production mode rejects wildcard CORS, non-HTTPS CORS origins, weak JWT secrets and insecure refresh cookies.
WIKI_ENVIRONMENT=development

# PostgreSQL
# Docker Compose backend uses postgres:5432.
# Host-side cargo run with compose Postgres should override this to localhost:3457.
WIKI_DATABASE__URL=postgres://wiki:[CHANGE_ME]@postgres:5432/wiki
WIKI_DATABASE__MAX_CONNECTIONS=20
WIKI_DATABASE__MIN_CONNECTIONS=5
WIKI_DATABASE__CONNECT_TIMEOUT_SECONDS=10
WIKI_DATABASE__IDLE_TIMEOUT_SECONDS=600

# JWT / Auth
WIKI_JWT_SECRET=[CHANGE_ME]
WIKI_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
WIKI_AUTH__REFRESH_TOKEN_TTL_DAYS=7
WIKI_AUTH__REGISTRATION_ENABLED=true
WIKI_AUTH__REFRESH_COOKIE_NAME=refresh_token
WIKI_AUTH__REFRESH_COOKIE_SECURE=true
WIKI_AUTH__REFRESH_COOKIE_SAME_SITE=Lax
WIKI_AUTH__REFRESH_COOKIE_PATH=/api/v1/auth

# Server
WIKI_SERVER__ADDRESS=0.0.0.0
WIKI_SERVER__PORT=3456
WIKI_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:19877,http://localhost:5173

# Storage (file uploads, default max upload is 25 MiB)
WIKI_STORAGE__DIR=/var/lib/wiki/uploads
WIKI_STORAGE__MAX_UPLOAD_BYTES=26214400

# Internal maintenance. No public API or CLI routes are exposed for these jobs.
WIKI_MAINTENANCE__ENABLED=true
WIKI_MAINTENANCE__INTERVAL_SECONDS=3600
WIKI_MAINTENANCE__STAGED_ATTACHMENT_TTL_HOURS=24
WIKI_MAINTENANCE__BATCH_SIZE=100

# Optional first admin bootstrap.
# Set email and password together on a fresh PostgreSQL database.
WIKI_BOOTSTRAP__ADMIN_EMAIL=
WIKI_BOOTSTRAP__ADMIN_USERNAME=
WIKI_BOOTSTRAP__ADMIN_PASSWORD=
WIKI_BOOTSTRAP__ADMIN_DISPLAY_NAME=

# Rust logging
RUST_LOG=info
